{
  "name": "obox-webapp-ext",
  "version": "1.0.0",
  "private": true,
  "description": "网页应用扩展（Obox 用户扩展，经 .oix 分发安装）：把内部站点以 Chrome 应用模式打开，按条目独立 profile。与 obox 宿主只有扩展 API 依赖关系。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "test": "node --test",
    "pack": "node scripts/pack.mjs",
    "release": "npm test && npm run build && npm run pack"
  },
  "dependencies": {
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "prettier": "^3.7.4",
    "vite": "^7.2.6"
  }
}
